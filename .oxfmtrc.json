{
    "semi": true,
    "singleQuote": false,
    "tabWidth": 4,
    "useTabs": false,
    "trailingComma": "none",
    "bracketSpacing": true,
    "arrowParens": "avoid",
    "printWidth": 120,
    "proseWrap": "never",
    "htmlWhitespaceSensitivity": "ignore",
    "quoteProps": "as-needed",
    "jsxSingleQuote": false,
    "embeddedLanguageFormatting": "auto",
    "singleAttributePerLine": false,
    "sortPackageJson": false,
    "ignorePatterns": [
        "node_modules/",
        "dist/",
        "coverage/",
        "pnpm-lock.yaml",
        "*.min.js",
        "*.min.css",
        ".DS_Store",
        "Thumbs.db",
        ".vscode/",
        ".idea/",
        "*.log",
        "*.tmp",
        "public/clubs.json",
        ".github/**/*.yml",
        ".github/**/*.yaml",
        "*.md"
    ]
}
