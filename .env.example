# Server port
PORT=3000

# Directory for cached assets
CACHE_DIR=./cache

# Application configuration as a JSON array
# Each app needs an id, repo (owner/name), and display name
APPS=[{"id":"myapp","repo":"owner/repo","name":"My App"}]

# GitHub authentication (optional but recommended for higher API limits)
GITHUB_TOKEN=ghp_your_token_here

# GitHub App authentication alternative (optional)
# GITHUB_APP_ID=123456
# GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Optional JSON config file path that overrides environment variables
# CONFIG_PATH=./config.json

# Logging level: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# The public origin clients should be sent to.
# Every updater response and the whole Sparkle appcast embed absolute download URLs built from
# this, so it must be the address the outside world uses - not localhost.
# REQUIRED when NODE_ENV=production; the server refuses to start without it.
# PUBLIC_BASE_URL=https://mirror.example.com

# CORS origin (optional)
# CORS_ORIGIN=https://example.com

# Admin API key for cache management endpoints (required for admin endpoints).
# Must be at least 32 characters; the server refuses to start if a shorter value is set.
# Generate one with: openssl rand -hex 32
# ADMIN_API_KEY=

# GitHub webhook secret for release webhooks (optional, minimum 32 characters).
# Generate one with: openssl rand -hex 32
# WEBHOOK_SECRET=

# Reserved for the upcoming smart-proxy feature: skip on-disk caching for assets larger than this size (bytes)
# MAX_CACHEABLE_SIZE=1073741824
