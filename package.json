{
    "name": "download-server",
    "version": "1.0.0",
    "description": "",
    "main": "dist/server/main.js",
    "type": "module",
    "engines": {
        "node": ">=22.12.0",
        "pnpm": ">=12.0.0"
    },
    "packageManager": "pnpm@12.4.1",
    "scripts": {
        "build": "pnpm run build:server && pnpm run build:public",
        "build:server": "tsc -p tsconfig.server.json",
        "build:public": "vite build",
        "check:bundle": "node scripts/check-bundle-budget.mjs",
        "db:check": "drizzle-kit check",
        "db:generate": "drizzle-kit generate",
        "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json --noEmit",
        "dev:public": "vite",
        "start": "node dist/server/main.js",
        "prod": "pnpm run build && pnpm run start",
        "test": "vitest run",
        "lint": "oxlint src tests scripts && node scripts/check-restricted-syntax.mjs",
        "lint:fix": "oxlint src tests scripts --fix",
        "format": "oxfmt --write",
        "format:check": "oxfmt --check",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{ts,tsx,js,jsx,mjs}": [
            "oxlint --fix",
            "oxfmt --write"
        ],
        "*.{ts,tsx}": "node -e \"require('child_process').execSync('pnpm run typecheck',{stdio:'inherit'})\""
    },
    "keywords": [],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "@fastify/cors": "^11.3.0",
        "@fastify/helmet": "^13.1.0",
        "@fastify/static": "^10.1.0",
        "@fastify/swagger": "^9.8.1",
        "@scalar/fastify-api-reference": "^1.72.1",
        "better-sqlite3": "^13.0.3",
        "dompurify": "^3.4.12",
        "dotenv": "^17.4.2",
        "drizzle-orm": "^0.45.3",
        "fastify": "^5.10.0",
        "highlight.js": "^11.11.1",
        "marked": "^18.0.6",
        "msgpackr": "^2.0.4",
        "pino": "^10.3.1",
        "prom-client": "^15.1.3",
        "semver": "^7.8.5",
        "ua-parser-js": "^2.0.10",
        "undici": "^8.7.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^9.6.0",
        "@types/dompurify": "^3.0.5",
        "@types/node": "^26.1.1",
        "@types/semver": "^7.8.0",
        "@types/ua-parser-js": "^0.7.39",
        "@vitest/coverage-v8": "^4.1.10",
        "drizzle-kit": "^0.31.11",
        "happy-dom": "^20.10.6",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.8",
        "oxfmt": "^0.70.0",
        "oxlint": "^1.85.0",
        "pino-pretty": "^13.1.3",
        "tsx": "^4.23.1",
        "typescript": "^6.0.3",
        "vite": "^8.1.5",
        "vitest": "^4.1.10"
    }
}
