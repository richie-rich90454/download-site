# pnpm's own defaults are already the strict ones: no phantom dependencies, and a
# node_modules that is a symlink farm rather than a flat copy. Nothing here relaxes them.
#
# shamefully-hoist is deliberately NOT set. It would re-create the flat node_modules that makes an
# undeclared import work locally and fail in production, which is the exact failure this project
# cannot afford.
auto-install-peers=true

# better-sqlite3 compiles a native addon. A failed or skipped build shows up as a module that
# imports fine and throws on first query, so failures are loud rather than silent.
strict-peer-dependencies=false
